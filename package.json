{
  "name": "nice-guy-web-design",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run playwright:install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:phases",
    "test:unit": "npx tsx --import ./scripts/preload-cli.ts --test tests/*.test.ts",
    "test:integration": "npx tsx --import ./scripts/preload-cli.ts --test tests/integration/*.test.ts",
    "test:ci": "npm run lint && npm run typecheck && npm run test",
    "deploy:check": "npx tsx --import ./scripts/preload-cli.ts scripts/deploy-check.ts",
    "db:indexes": "npx tsx --import ./scripts/preload-cli.ts scripts/sync-indexes.ts",
    "db:indexes:apply": "npx tsx --import ./scripts/preload-cli.ts scripts/sync-indexes.ts --apply",
    "smoke:production": "npx tsx --import ./scripts/preload-cli.ts scripts/production-smoke-test.ts",
    "playwright:install": "playwright install chromium",
    "playwright:check": "node scripts/check-playwright.mjs",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:pagespeed": "npx tsx --test tests/pagespeed-parser.test.ts",
    "test:niceguy": "npx tsx --test tests/niceguy-scoring.test.ts",
    "test:ai": "npx tsx --test tests/ai-analysis.test.ts",
    "test:dashboard": "npx tsx --test tests/audit-dashboard.test.ts tests/audit-sections.test.ts tests/audit-dashboard-ui.test.ts",
    "test:reports": "npx tsx --test tests/public-reports.test.ts",
    "test:pdf": "npx tsx --test tests/pdf-reports.test.ts",
    "test:outreach": "npx tsx --test tests/outreach-email.test.ts",
    "test:demo": "npx tsx --test tests/demo-generation.test.ts",
    "test:activity": "npx tsx --test tests/activity-timeline.test.ts",
    "test:audit": "npx tsx --test tests/audit-history.test.ts",
    "test:rate-limit": "npx tsx --test tests/rate-limit.test.ts",
    "test:deployment": "npx tsx --test tests/deployment-env.test.ts",
    "test:dev-setup": "npx tsx --test tests/dev-setup.test.ts",
    "test:phases": "npx tsx --test tests/phases/phase-*.test.ts",
    "test:phase:01": "npx tsx --test tests/phases/phase-01-foundation.test.ts",
    "test:phase:02": "npx tsx --test tests/phases/phase-02-website-crud.test.ts",
    "test:phase:03": "npx tsx --test tests/phases/phase-03-crawling.test.ts",
    "test:phase:04": "npx tsx --test tests/phases/phase-04-screenshots.test.ts",
    "test:phase:05": "npx tsx --test tests/phases/phase-05-crawl-integration.test.ts",
    "test:phase:06": "npx tsx --test tests/phases/phase-06-pagespeed.test.ts",
    "test:phase:07": "npx tsx --test tests/phases/phase-07-niceguy-metrics.test.ts",
    "test:phase:08": "npx tsx --test tests/phases/phase-08-ai-analysis.test.ts",
    "test:phase:09": "npx tsx --test tests/phases/phase-09-dashboard.test.ts",
    "test:phase:10": "npx tsx --test tests/phases/phase-10-public-reports.test.ts",
    "test:phase:11": "npx tsx --test tests/phases/phase-11-pdf-reports.test.ts",
    "test:phase:12": "npx tsx --test tests/phases/phase-12-outreach.test.ts",
    "test:phase:13": "npx tsx --test tests/phases/phase-13-demo.test.ts",
    "test:phase:14": "npx tsx --test tests/phases/phase-14-activity.test.ts",
    "test:phase:15": "npx tsx --test tests/phases/phase-15-audit-history.test.ts",
    "test:phase:16": "npx tsx --test tests/phases/phase-16-auth.test.ts",
    "test:phase:17": "npx tsx --test tests/phases/phase-17-rate-limit.test.ts",
    "test:phase:18": "npx tsx --test tests/phases/phase-18-deployment.test.ts",
    "dev:check": "npx tsx --import ./scripts/preload-cli.ts scripts/dev-check.ts",
    "dev:seed-test-website": "npx tsx --import ./scripts/preload-cli.ts scripts/seed-test-website.ts",
    "admin:create": "npx tsx --import ./scripts/preload-cli.ts scripts/create-administrator.ts",
    "worker:audit": "npx tsx --import ./scripts/preload-cli.ts scripts/audit-worker.ts",
    "worker:audit:once": "npx tsx --import ./scripts/preload-cli.ts scripts/audit-worker.ts --once",
    "audit:worker": "npm run worker:audit",
    "audit:worker:once": "npm run worker:audit:once",
    "test:audit:acceptance": "npx tsx --import ./scripts/preload-cli.ts scripts/local-audit-acceptance-test.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@react-pdf/renderer": "^4.5.1",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.23.0",
    "mongodb": "^7.4.0",
    "mongoose": "^9.7.4",
    "next": "16.0.10",
    "playwright": "^1.62.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-social-icons": "^6.26.0",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.35",
    "daisyui": "^5.5.19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
