{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niceguywebdesign.com/schemas/audit-result-1.1.json",
  "title": "Nice Guy Audit Analysis Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditId",
    "analysisRequestId",
    "assessment",
    "executiveSummary",
    "strengths",
    "issues",
    "limitations",
    "analyzedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "auditId": { "type": "string" },
    "analysisRequestId": { "type": "string" },
    "assessment": {
      "type": "object",
      "required": ["priority", "confidence", "summary"],
      "properties": {
        "priority": { "enum": ["critical", "high", "moderate", "low"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": { "type": "string", "maxLength": 2000 }
      }
    },
    "executiveSummary": { "type": "string", "maxLength": 8000 },
    "strengths": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["title", "description", "sources"],
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "description": { "type": "string", "maxLength": 4000 },
          "category": { "type": "string" },
          "sources": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["title", "description", "severity", "category", "recommendation", "sources"],
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "description": { "type": "string", "maxLength": 4000 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "category": { "type": "string", "maxLength": 100 },
          "recommendation": { "type": "string", "maxLength": 4000 },
          "sources": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "analyzedAt": { "type": "string", "format": "date-time" },
    "deprecatedAiOverallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Deprecated. Do not use as the official audit score."
    }
  }
}
