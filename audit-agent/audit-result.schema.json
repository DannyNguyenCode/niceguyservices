{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niceguywebdesign.com/schemas/audit-result-1.1.json",
  "title": "Nice Guy Audit Analysis Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditId",
    "analysisRequestId",
    "assessment",
    "executiveSummary",
    "strengths",
    "issues",
    "limitations",
    "analyzedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "auditId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "analysisRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "confidence", "summary"],
      "properties": {
        "priority": { "enum": ["critical", "high", "moderate", "low"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "executiveSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "strengths": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "sources"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "severity", "category", "recommendation", "sources"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "analyzedAt": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "homepageChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "priorityChanges"],
      "description": "Customer-facing homepage improvement recommendations grounded only in supplied audit evidence.",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "priorityChanges": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "priority",
              "category",
              "problem",
              "recommendation",
              "expectedImpact"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "priority": { "enum": ["high", "medium", "low"] },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "recommendation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "expectedImpact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    },
    "deprecatedAiOverallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Deprecated. Do not use as the official audit score."
    }
  }
}
